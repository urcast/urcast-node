# Copy this file to .env and fill in the values, or let setup_node.py create it.
# Never commit .env; it contains the node credentials and JWT.

# urcast API and MQTT broker
URCAST_API_URL=http://localhost:8000
URCAST_MQTT_BROKER=localhost
URCAST_MQTT_PORT=1883

# Node identity. setup_node.py fills these in automatically.
URCAST_NODE_ID=
URCAST_NODE_TOKEN=
URCAST_EMAIL=
URCAST_PASSWORD=

# Node registration details
URCAST_NODE_NAME=pi5-outdoor
URCAST_NODE_LOCATION=Dublin, Ireland
URCAST_NODE_LATITUDE=
URCAST_NODE_LONGITUDE=

# Runtime
URCAST_READ_INTERVAL_S=3.0
