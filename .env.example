# Copy this file to .env (setup_node.py does this automatically).
# The real .env holds the JWT and account credentials, so it is git-ignored.

# --- urcast API ---
# Address of the urcast backend, without a trailing slash.
API_URL=http://localhost:8000

# --- MQTT broker ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=urcast

# --- Account session (written automatically by setup_node.py) ---
# The password is only stored so the node can log in again and refresh the
# JWT before it expires. Keep .env readable by your user only (chmod 600).
AUTH_EMAIL=
AUTH_PASSWORD=
JWT_TOKEN=

# --- Node identity (written automatically after registration) ---
NODE_ID=
NODE_NAME=pi5-outdoor
NODE_LOCATION=
NODE_LATITUDE=
NODE_LONGITUDE=

# --- Token refresh ---
# Log in again this many seconds before the JWT expires.
TOKEN_REFRESH_MARGIN_S=300

# --- Sensor loop ---
READ_INTERVAL_S=3.0

# Pins use the names from the Adafruit board module (BCM numbering).
DHT_PIN=D4
BMP_SDA_PIN=D17
BMP_SCL_PIN=D27
BMP280_ADDRESS=0x76

# TSL2591 settings: low/medium/high/max and 100ms/200ms/300ms/400ms/500ms/600ms
TSL_GAIN=low
TSL_INTEGRATION_TIME=100ms
