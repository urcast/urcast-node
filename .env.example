# Copy this file to .env and fill in the values, or let setup_node.py create it.
# Never commit .env; it contains the node credentials and JWT.

# urcast API and MQTT broker
URCAST_API_URL=https://urcast.pjmisev.com
URCAST_MQTT_BROKER=urcast.pjmisev.com
URCAST_MQTT_PORT=8883

# Node identity. setup_node.py fills these in automatically.
URCAST_NODE_ID=
URCAST_NODE_TOKEN=
URCAST_EMAIL=
URCAST_PASSWORD=

# Node registration details, change manually
URCAST_NODE_NAME=johndoe-outdoor-garden
URCAST_NODE_LOCATION=Dublin, Ireland

URCAST_NODE_LATITUDE=53.32382908805492
URCAST_NODE_LONGITUDE=-6.3176879781791895

# Runtime
URCAST_READ_INTERVAL_S=60.0
