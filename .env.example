# Copy this file to .env and fill in the values, or let setup_node.py create it.
# Never commit .env; it contains the node credentials and JWT.

# urcast API and MQTT broker. MQTT uses TLS on 8883; the broker hostname must
# stay a DNS-only (grey cloud) record pointing at the EC2 IP -- do not turn on
# the Cloudflare proxy, which only handles HTTP(S)
URCAST_API_URL=https://urcast.pjmisev.com
URCAST_MQTT_BROKER=urcast.pjmisev.com
URCAST_MQTT_PORT=8883

# Node identity. setup_node.py fills these in automatically.
URCAST_NODE_ID=
URCAST_NODE_TOKEN=
URCAST_EMAIL=
URCAST_PASSWORD=

# Node registration details, change manually
URCAST_NODE_NAME=johndoe-outdoor-garden
URCAST_NODE_LOCATION=Dublin, Ireland

URCAST_NODE_LATITUDE=53.32382908805492
URCAST_NODE_LONGITUDE=-6.3176879781791895

# Runtime
URCAST_READ_INTERVAL_S=60.0

# Docker only. docker-compose.prod.yml uses these to pick the gpiochip, the
# gpio/i2c group ids and the uid/gid that writes .env from inside the
# container. The defaults match Raspberry Pi OS, so they can stay commented.
#NODE_GPIO_CHIP=/dev/gpiochip0
#GPIO_GID=986
#I2C_GID=997
#NODE_UID=1000
#NODE_GID=1000
